<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicBetter.Views.EmbedPlayerPage"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <Grid Grid.Row="0" Padding="16,50,16,10" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Text="←" FontSize="22" TextColor="White" BackgroundColor="Transparent"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{Binding TrackTitle}" TextColor="White" FontAttributes="Bold"
                   FontSize="16" VerticalOptions="Center" Margin="10,0,0,0" LineBreakMode="TailTruncation" />
        </Grid>

        <WebView Grid.Row="1" x:Name="PlayerWebView" />
    </Grid>
</ContentPage>
